{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "../../dist/bundle",
    "noImplicitAny": true,
    "strict": true,
    "jsx": "react",
    "paths": {
      "ui-styles": ["./styles/ui/*"],
      "styles": ["./styles/*"]
    }
  },
  "include": ["../shared", "../client", "./declarations"],
}
