{
  "name": "jig-puzzle",
  "version": "0.0.1",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "start": "node ./dist/server/index.js",
    "build": "export NODE_ENV=production && npm run build -w src/server && npm run bundle:client",
    "run:client": "node ./dist/client/index.js",
    "run:server": "node ./dist/server/index.js",
    "build:watch:client": "npm run watch -w src/client",
    "build:watch:server": "npm run watch -w src/server",
    "run:watch:server": "node --watch-path=./dist/ ./dist/server/index.js",
    "bundle:client": "webpack --config ./src/client/webpack.config.js",
    "bundle:client:watch": "webpack --config ./src/client/webpack.config.js --watch",
    "run:ts:script": "node  --import file:/Applications/WebStorm.app/Contents/plugins/nodeJS/js/ts-file-loader/node_modules/tsx/dist/loader.cjs",
    "gen": "node  --import file:/Applications/WebStorm.app/Contents/plugins/nodeJS/js/ts-file-loader/node_modules/tsx/dist/loader.cjs ./scripts/gen.ts",
    "gen2": "npm run run:ts:script ./scripts/gen.ts"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "private": true,
  "workspaces": [
    "src/client",
    "src/server",
    "src/shared"
  ]
}
